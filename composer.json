{
  "name": "brasth/brasth-document-sync-for-google-docs",
  "description": "Document synchronization tools for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "DocSyncWP\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpcsstandards/phpcsutils": "^1.2.3",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test:failure-digest": "php scripts/verify-failure-digest.php",
    "test:zip-package-limits": "php scripts/verify-zip-package-limits.php",
    "test:doc-metadata-fixtures": "php scripts/verify-doc-metadata-fixtures.php",
    "test:synced-region-merge": "php scripts/verify-synced-region-merge.php",
    "test:apply-policy": "php scripts/verify-apply-policy.php",
    "test:knowledge-base-helpers": "php scripts/verify-knowledge-base-helpers.php",
    "test:folder-watch-update": "php scripts/verify-folder-watch-update.php",
    "test:html-zip-extractor": "php scripts/verify-html-zip-extractor.php",
    "test:schedule-resolver": "php scripts/verify-schedule-resolver.php",
    "test:elementor-fixtures": "php scripts/verify-elementor-fixtures.php",
    "test:large-doc-fallback-fixtures": "php scripts/verify-large-doc-fallback-fixtures.php",
    "test:output-fidelity-fixtures": "php scripts/verify-output-fidelity-fixtures.php",
    "test:layout-fixtures": "php scripts/verify-layout-fixtures.php",
    "test:telemetry-settings": "php scripts/verify-telemetry-settings.php",
    "autoload": "composer dump-autoload -o"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
