{
  "name": "docsync-wp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode admin",
    "build": "vite build --mode admin && vite build --mode post-sync",
    "lint": "pnpm lint:js && pnpm lint:no-phpcs-ignore",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint . --max-warnings=0",
    "lint:no-phpcs-ignore": "! rg --regexp \"phpcs:[i]gnore\" docsync-wp.php src uninstall.php",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@wordpress/a11y": "^4.46.0",
    "@wordpress/api-fetch": "^7.46.0",
    "@wordpress/components": "^33.1.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^6.19.0",
    "@wordpress/url": "^4.46.0",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
