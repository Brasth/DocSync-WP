{
  "name": "brasth-document-sync-for-google-docs",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode setup",
    "build": "vite build --mode setup && vite build --mode sources && vite build --mode logs && vite build --mode post-sync && vite build --mode doc-source-modal && vite build --mode drive-browser",
    "i18n": "pnpm i18n:pot && pnpm i18n:json",
    "i18n:json": "node scripts/make-js-translations.mjs",
    "i18n:pot": "node scripts/make-pot.mjs",
    "lint": "pnpm lint:js && pnpm lint:no-phpcs-ignore && pnpm lint:screenshots && pnpm lint:blueprint",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint . --max-warnings=0",
    "lint:blueprint": "node scripts/lint-blueprint.mjs",
    "lint:no-phpcs-ignore": "! rg --regexp \"phpcs:[i]gnore\" brasth-document-sync-for-google-docs.php src uninstall.php",
    "lint:screenshots": "node scripts/lint-screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-tabs": "^1.1.15",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@wordpress/a11y": "^4.48.1",
    "@wordpress/api-fetch": "^7.48.1",
    "@wordpress/components": "^33.1.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^6.21.1",
    "@wordpress/url": "^4.48.1",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.1",
      "postcss": "^8.5.23"
    }
  }
}
