<?xml version="1.0"?>
<ruleset name="Brasth Document Sync for Google Docs">
	<description>WordPress coding standards for Brasth Document Sync for Google Docs.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<file>brasth-document-sync-for-google-docs.php</file>
	<file>src</file>
	<file>uninstall.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- PHP DOM extension properties use fixed mixed-case API names. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="childNodes"/>
				<element value="ownerDocument"/>
				<element value="parentNode"/>
				<element value="tagName"/>
				<element value="textContent"/>
			</property>
		</properties>
	</rule>

	<!-- Sync locks require compare-and-swap SQL against the options table to avoid duplicate imports. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery.DirectQuery">
		<exclude-pattern>src/Sync/SyncLock.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery.NoCaching">
		<exclude-pattern>src/Sync/SyncLock.php</exclude-pattern>
	</rule>

	<!-- Source listings intentionally query postmeta because linked Google Docs are stored as post metadata. -->
	<rule ref="WordPress.DB.SlowDBQuery.slow_db_query_meta_key">
		<exclude-pattern>src/Sync/SourceRepository.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery.slow_db_query_meta_query">
		<exclude-pattern>src/Sync/SourceRepository.php</exclude-pattern>
		<exclude-pattern>src/Sync/MediaAssetImporter.php</exclude-pattern>
	</rule>

	<!-- HTML ZIP imports must manipulate temporary export files before handing images to WordPress media APIs. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>src/Google/DocsClient.php</exclude-pattern>
		<exclude-pattern>src/Sync/HtmlZipPackageExtractor.php</exclude-pattern>
		<exclude-pattern>src/Sync/MediaAssetImporter.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="brasth-document-sync-for-google-docs"/>
			</property>
		</properties>
	</rule>
</ruleset>
